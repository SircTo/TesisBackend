# Copia este archivo como ".env" y completa los valores reales.
# El archivo .env NO se sube al repositorio (ver .gitignore).

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sjmr_restaurante
DB_USER=postgres
DB_PASSWORD=tu_password
# Poner en true si la base exige conexión SSL (ej: base hosteada / Coolify)
DB_SSL=false

# --- Autenticación (JWT) ---
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=8h

# --- CORS ---
# Origen permitido del frontend (Angular). Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:4200
